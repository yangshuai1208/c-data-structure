{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Current C File",
            "command": "cl.exe",
            "args": [
                "/W4",
                "/TC",
                "${file}",
                "/Fe:${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}